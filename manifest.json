{
  "manifest_version": 3,
  "name": "X Ad Blocker",
  "version": "1.0",
  "description": "Hide ads on X",
  "host_permissions": ["https://twitter.com/*", "https://x.com/*"],
  "content_scripts": [{
    "matches": ["https://twitter.com/*", "https://x.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}