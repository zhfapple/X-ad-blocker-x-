{
  "manifest_version": 3,
  "name": "X/Twitter 零跳动去广告 (数据层)",
  "version": "1.0.0",
  "description": "通过拦截并清洗 HomeTimeline 等 GraphQL 接口数据，从源头剔除 X/Twitter 广告，彻底解决页面滚动跳动问题。",
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "https://twitter.com/*",
    "https://x.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["https://twitter.com/*", "https://x.com/*"]
    }
  ]
}